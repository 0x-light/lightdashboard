/*
  # Security Headers for Privacy-First Dashboard
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  
  # Content Security Policy - Allow only necessary external APIs
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.hyperliquid.xyz https://mainnet.zklighter.elliot.ai https://api.opensea.io https://api.coingecko.com https://api.open-meteo.com https://api.bigdatacloud.net https://www.gocomics.com https://assets.coingecko.com https://api.allorigins.win https://hermes.pyth.network; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;
  
  # Cache control for static assets
  Cache-Control: public, max-age=3600, must-revalidate

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/favicon-*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800

